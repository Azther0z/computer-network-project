[Unit]
Description=Talkmato Next.js frontend
After=network.target
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=talkmato
Group=talkmato
WorkingDirectory=/srv/talkmato/current/frontend
Environment=NODE_ENV=production
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3000
Environment=NEXT_TELEMETRY_DISABLED=1
ExecStart=/srv/talkmato/current/runtime/node server.js
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/srv/talkmato/current/frontend/.next/cache

[Install]
WantedBy=multi-user.target
