PORT=8080
FRONTEND_ORIGIN=http://localhost:3000
DATABASE_PATH=./data/talkmato.dev.sqlite
# Set privately in the backend process environment. Never use NEXT_PUBLIC_ for these values.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_AUTH_TOKEN=
# On GCE, use a pinned Secret Manager version instead of a raw token.
CLOUDFLARE_TOKEN_SECRET_VERSION=
